{
  "name": "github-multi-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers MCP gateway with encrypted, per-owner GitHub tokens and rotating OAuth sessions",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply GITHUB_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply GITHUB_DB --remote",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.js",
    "check": "npm run typecheck",
    "cf:db:create": "node scripts/with-secondary-cloudflare.mjs d1 create github-multi-connect",
    "cf:migrate": "node scripts/with-secondary-cloudflare.mjs d1 migrations apply GITHUB_DB --remote",
    "cf:deploy": "node scripts/with-secondary-cloudflare.mjs deploy --secrets-file .secrets.json",
    "cf:secrets": "node scripts/with-secondary-cloudflare.mjs secret bulk .secrets.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "validate": "npm run check && npm test"
  },
  "devDependencies": {
    "wrangler": "^4.44.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "author": "Fongap Labs"
}
