{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-multi-connect",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "MCP_PUBLIC_URL": "https://github-multi-connect.YOUR-SUBDOMAIN.workers.dev/mcp",
    "GITHUB_WRITE_ENABLED": "false",
    "ALLOW_FILE_CONTENT": "false",
    "OAUTH_TOKEN_TTL_SECONDS": "900"
  },
  "d1_databases": [{
    "binding": "GITHUB_DB",
    "database_name": "github-multi-connect",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["0 4 * * *"]}
}
